#!/usr/bin/env bash
# Verification harness for stt-gpui. Build the shell once, then drive the
# short-lived stt-shell binary the way a user runs it. Never kill by process
# name. Cleanup deletes the run directory and leaves evidence in place.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if REPO_ROOT=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null); then
  :
else
  REPO_ROOT=$(cd "$SCRIPT_DIR/../../../.." && pwd)
fi

CURRENT_FILE=/tmp/stt-gpui-verify-current
ARTIFACTS_ROOT=/tmp/stt-gpui-verify-artifacts

usage() {
  cat <<'EOF'
Usage: control-stt-gpui <command> [args]

Commands:
  launch     Build stt-shell into an isolated target directory.
  doctor     Read-only health check for the launched instance.
  cli [-- <args>]
             Run the built stt-shell binary. Extra args are forwarded.
  overlay    Build stt-overlay, run bubble model tests, prove the X11 window.
  session    Build stt-session, run compositor tests, probe startup exits.
  cleanup    Remove the run directory. Leaves evidence on disk.

Environment:
  STT_GPUI_VERIFY_RUN_ID   Isolate concurrent runs. Required when a current
                           run already exists and you need a second instance.

Evidence lands in /tmp/stt-gpui-verify-artifacts/<run-id>/ and survives cleanup.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

run_id_from_env_or_current() {
  if [[ -n "${STT_GPUI_VERIFY_RUN_ID:-}" ]]; then
    printf '%s\n' "$STT_GPUI_VERIFY_RUN_ID"
    return
  fi
  if [[ -f "$CURRENT_FILE" ]]; then
    cat "$CURRENT_FILE"
    return
  fi
  die "no launched instance. Run launch first, or set STT_GPUI_VERIFY_RUN_ID."
}

run_dir_for() {
  printf '/tmp/stt-gpui-verify-%s\n' "$1"
}

state_file_for() {
  printf '%s/state.env\n' "$(run_dir_for "$1")"
}

load_state() {
  local id="$1"
  local state
  state=$(state_file_for "$id")
  [[ -f "$state" ]] || die "instance $id has no state file at $state"
  # shellcheck disable=SC1090
  source "$state"
}

expected_version() {
  local toml="$REPO_ROOT/crates/stt-shell/Cargo.toml"
  [[ -f "$toml" ]] || die "missing $toml"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$toml" | head -n 1)
  [[ -n "$version" ]] || die "could not read version from $toml"
  printf '%s\n' "$version"
}

overlay_from_crate() {
  if [[ -f "$REPO_ROOT/crates/stt-overlay/Cargo.toml" ]]; then
    printf 'present\n'
  else
    printf 'absent\n'
  fi
}

hotkey_from_crate() {
  if [[ -f "$REPO_ROOT/crates/stt-hotkey/Cargo.toml" ]]; then
    printf 'present\n'
  else
    printf 'absent\n'
  fi
}

cmd_launch() {
  local run_id
  if [[ -n "${STT_GPUI_VERIFY_RUN_ID:-}" ]]; then
    run_id=$STT_GPUI_VERIFY_RUN_ID
  else
    run_id=$(date +%Y%m%dT%H%M%S)-$$
  fi

  local run_dir target artifacts binary version overlay hotkey
  run_dir=$(run_dir_for "$run_id")
  target=$run_dir/target
  artifacts=$ARTIFACTS_ROOT/$run_id
  mkdir -p "$target" "$artifacts" "$run_dir"

  version=$(expected_version)
  overlay=$(overlay_from_crate)
  hotkey=$(hotkey_from_crate)

  echo "building stt-shell into $target"
  CARGO_TARGET_DIR=$target cargo build -p stt-shell --manifest-path "$REPO_ROOT/Cargo.toml"

  binary=$target/debug/stt-shell
  if [[ ! -x "$binary" && -x "$target/debug/stt-shell.exe" ]]; then
    binary=$target/debug/stt-shell.exe
  fi
  [[ -x "$binary" ]] || die "build finished but binary is missing at $target/debug/stt-shell"

  local probe_out probe_err probe_code
  probe_out=$run_dir/launch-probe.stdout
  probe_err=$run_dir/launch-probe.stderr
  set +e
  "$binary" >"$probe_out" 2>"$probe_err"
  probe_code=$?
  set -e
  [[ "$probe_code" -eq 0 ]] || die "launch probe exited $probe_code"

  cat >"$(state_file_for "$run_id")" <<EOF
RUN_ID=$run_id
REPO_ROOT=$REPO_ROOT
RUN_DIR=$run_dir
TARGET_DIR=$target
BINARY=$binary
VERSION=$version
ARTIFACTS=$artifacts
SURFACE=cli
OVERLAY=$overlay
HOTKEY=$hotkey
EOF

  printf '%s\n' "$run_id" >"$CURRENT_FILE"

  echo "ready run_id=$run_id"
  echo "binary=$binary"
  echo "version=$version"
  echo "artifacts=$artifacts"
  echo "surface=cli"
  echo "overlay=$overlay"
  echo "hotkey=$hotkey"
}

cmd_doctor() {
  command -v cargo >/dev/null || die "cargo is not on PATH"
  command -v rustc >/dev/null || die "rustc is not on PATH"

  local run_id
  run_id=$(run_id_from_env_or_current)
  load_state "$run_id"

  [[ -d "$RUN_DIR" ]] || die "run directory missing: $RUN_DIR"
  [[ -x "$BINARY" ]] || die "binary missing or not executable: $BINARY"
  case "$BINARY" in
    "$RUN_DIR"/*) ;;
    *) die "binary $BINARY is not inside the launched run directory $RUN_DIR" ;;
  esac

  local expected actual_out actual_err actual_code
  expected=$(expected_version)
  [[ "$VERSION" == "$expected" ]] || die "state version $VERSION does not match Cargo.toml $expected"

  actual_out=$(mktemp)
  actual_err=$(mktemp)
  set +e
  "$BINARY" >"$actual_out" 2>"$actual_err"
  actual_code=$?
  set -e

  local stdout_text
  stdout_text=$(head -n 1 "$actual_out" | tr -d '\r')
  rm -f "$actual_out" "$actual_err"

  [[ "$actual_code" -eq 0 ]] || die "binary exited $actual_code"
  [[ "$stdout_text" == "stt-shell $expected" ]] || die "stdout was $(printf '%q' "$stdout_text"), expected stt-shell $expected"

  local expected_overlay expected_hotkey
  expected_overlay=$(overlay_from_crate)
  [[ "$OVERLAY" == "$expected_overlay" ]] || die "state overlay $OVERLAY does not match crate $expected_overlay"
  expected_hotkey=$(hotkey_from_crate)
  [[ "$HOTKEY" == "$expected_hotkey" ]] || die "state hotkey $HOTKEY does not match crate $expected_hotkey"

  echo "ok cargo=$(command -v cargo)"
  echo "ok rustc=$(command -v rustc)"
  echo "ok run_id=$RUN_ID"
  echo "ok binary=$BINARY"
  echo "ok version=$expected"
  echo "ok stdout=stt-shell $expected"
  echo "ok surface=$SURFACE"
  echo "ok overlay=$OVERLAY"
  echo "ok hotkey=$HOTKEY"
  echo "ok target=$TARGET_DIR"
  echo "ok artifacts=$ARTIFACTS"
}

cmd_cli() {
  local run_id
  run_id=$(run_id_from_env_or_current)
  load_state "$run_id"
  [[ -x "$BINARY" ]] || die "binary missing: $BINARY"

  mkdir -p "$ARTIFACTS"
  local stamp out err meta combined
  stamp=$(date +%Y%m%dT%H%M%S)-$$
  out=$ARTIFACTS/cli-$stamp.stdout.txt
  err=$ARTIFACTS/cli-$stamp.stderr.txt
  meta=$ARTIFACTS/cli-$stamp.meta.txt
  combined=$ARTIFACTS/cli-$stamp.transcript.txt

  local code
  set +e
  "$BINARY" "$@" >"$out" 2>"$err"
  code=$?
  set -e

  {
    echo "command: $BINARY $*"
    echo "exit: $code"
    echo "stdout_path: $out"
    echo "stderr_path: $err"
  } >"$meta"

  {
    echo "\$ $BINARY $*"
    echo "--- stdout ---"
    cat "$out"
    echo "--- stderr ---"
    cat "$err"
    echo "--- exit $code ---"
  } >"$combined"

  echo "exit=$code"
  echo "stdout_path=$out"
  echo "stderr_path=$err"
  echo "transcript_path=$combined"
  echo "--- stdout ---"
  cat "$out"
  echo "--- stderr ---"
  cat "$err"
  return "$code"
}

cmd_overlay() {
  local run_id
  run_id=$(run_id_from_env_or_current)
  load_state "$run_id"
  [[ -f "$REPO_ROOT/crates/stt-overlay/Cargo.toml" ]] || die "missing $REPO_ROOT/crates/stt-overlay/Cargo.toml"
  [[ "$OVERLAY" == "present" ]] || die "state overlay=$OVERLAY. Relaunch after adding crates/stt-overlay."

  mkdir -p "$ARTIFACTS"
  local stamp art out err meta combined bin
  stamp=$(date +%Y%m%dT%H%M%S)-$$
  art=$ARTIFACTS/overlay-$stamp
  mkdir -p "$art"
  out=$art/cargo-test.stdout.txt
  err=$art/cargo-test.stderr.txt
  meta=$art/meta.txt
  combined=$art/transcript.txt

  unset WAYLAND_DISPLAY || true
  unset ZED_HEADLESS || true

  echo "building and testing stt-overlay in $TARGET_DIR"
  local code
  set +e
  CARGO_TARGET_DIR=$TARGET_DIR cargo test -p stt-overlay --manifest-path "$REPO_ROOT/Cargo.toml" -- --nocapture >"$out" 2>"$err"
  code=$?
  set -e

  {
    echo "command: CARGO_TARGET_DIR=$TARGET_DIR cargo test -p stt-overlay"
    echo "exit: $code"
    echo "display: ${DISPLAY-<unset>}"
    echo "wayland_display: unset"
  } >"$meta"

  if [[ "$code" -ne 0 ]]; then
    {
      echo "\$ cargo test -p stt-overlay"
      echo "--- stdout ---"
      cat "$out"
      echo "--- stderr ---"
      cat "$err"
      echo "--- exit $code ---"
    } >"$combined"
    echo "exit=$code"
    echo "transcript_path=$combined"
    echo "--- stdout ---"
    cat "$out"
    echo "--- stderr ---"
    cat "$err"
    return "$code"
  fi

  bin=$TARGET_DIR/debug/stt-overlay
  if [[ ! -x "$bin" && -x "$TARGET_DIR/debug/stt-overlay.exe" ]]; then
    bin=$TARGET_DIR/debug/stt-overlay.exe
  fi
  [[ -x "$bin" ]] || die "overlay binary missing at $TARGET_DIR/debug/stt-overlay"

  if [[ -z "${DISPLAY:-}" ]]; then
    echo "skip: no X11 DISPLAY; overlay window presence not proven" | tee "$art/skip.txt"
    {
      echo "\$ cargo test -p stt-overlay"
      echo "--- stdout ---"
      cat "$out"
      echo "--- stderr ---"
      cat "$err"
      echo "--- skip: no X11 DISPLAY ---"
      echo "--- exit 0 ---"
    } >"$combined"
    echo "exit=0"
    echo "transcript_path=$combined"
    echo "artifacts=$art"
    return 0
  fi

  DISPLAY="$DISPLAY" xwininfo -name stt-overlay >"$art/xwininfo-before.txt" 2>&1 || true
  : >"$art/overlay.stdout.txt"
  : >"$art/overlay.stderr.txt"
  DISPLAY="$DISPLAY" "$bin" >"$art/overlay.stdout.txt" 2>"$art/overlay.stderr.txt" &
  local pid=$!
  echo "$pid" >"$art/overlay.pid"

  local opened=0
  local i
  for i in $(seq 1 40); do
    if grep -q 'stt-overlay: window opened' "$art/overlay.stderr.txt" 2>/dev/null; then
      opened=1
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.25
  done

  local xwin_code
  set +e
  DISPLAY="$DISPLAY" xwininfo -name stt-overlay >"$art/xwininfo-name.txt" 2>&1
  xwin_code=$?
  set -e

  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -9 "$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true

  {
    echo "log_opened=$opened"
    echo "xwininfo_exit=$xwin_code"
    echo "pid=$pid"
  } >>"$meta"

  {
    echo "\$ cargo test -p stt-overlay"
    echo "--- stdout ---"
    cat "$out"
    echo "--- stderr ---"
    cat "$err"
    echo "--- xwininfo -name stt-overlay ---"
    cat "$art/xwininfo-name.txt"
    echo "--- overlay stderr ---"
    cat "$art/overlay.stderr.txt"
    echo "--- exit 0 ---"
  } >"$combined"

  if [[ "$xwin_code" -ne 0 ]] || ! grep -q 'Map State: IsViewable' "$art/xwininfo-name.txt"; then
    echo "error: overlay window not mapped" >&2
    echo "exit=1"
    echo "transcript_path=$combined"
    echo "--- xwininfo ---"
    cat "$art/xwininfo-name.txt"
    echo "--- overlay stderr ---"
    cat "$art/overlay.stderr.txt"
    return 1
  fi

  echo "exit=0"
  echo "transcript_path=$combined"
  echo "xwininfo_path=$art/xwininfo-name.txt"
  echo "artifacts=$art"
  echo "--- xwininfo ---"
  cat "$art/xwininfo-name.txt"
  return 0
}

cmd_session() {
  local run_id
  run_id=$(run_id_from_env_or_current)
  load_state "$run_id"
  [[ -f "$REPO_ROOT/crates/stt-session/Cargo.toml" ]] || die "missing $REPO_ROOT/crates/stt-session/Cargo.toml"

  mkdir -p "$ARTIFACTS"
  local stamp art out err meta combined bin
  stamp=$(date +%Y%m%dT%H%M%S)-$$
  art=$ARTIFACTS/session-$stamp
  mkdir -p "$art"
  out=$art/cargo-test.stdout.txt
  err=$art/cargo-test.stderr.txt
  meta=$art/meta.txt
  combined=$art/transcript.txt

  # Host-local link path for -lxkbcommon-x11 where the dev package is absent.
  # Never committed; CI installs libxkbcommon-x11-dev instead.
  if [[ -f "$HOME/.local/lib/stt-build/libxkbcommon-x11.so" ]]; then
    export RUSTFLAGS="${RUSTFLAGS:-} -L $HOME/.local/lib/stt-build"
  fi

  echo "building and testing stt-session in $TARGET_DIR"
  local code
  set +e
  CARGO_TARGET_DIR=$TARGET_DIR cargo test -p stt-session --manifest-path "$REPO_ROOT/Cargo.toml" -- --nocapture >"$out" 2>"$err"
  code=$?
  set -e

  {
    echo "command: CARGO_TARGET_DIR=$TARGET_DIR cargo test -p stt-session"
    echo "exit: $code"
  } >"$meta"

  if [[ "$code" -ne 0 ]]; then
    {
      echo "\$ cargo test -p stt-session"
      echo "--- stdout ---"
      cat "$out"
      echo "--- stderr ---"
      cat "$err"
      echo "--- exit $code ---"
    } >"$combined"
    echo "exit=$code"
    echo "transcript_path=$combined"
    return "$code"
  fi

  bin=$TARGET_DIR/debug/stt-session
  if [[ ! -x "$bin" && -x "$TARGET_DIR/debug/stt-session.exe" ]]; then
    bin=$TARGET_DIR/debug/stt-session.exe
  fi
  if [[ ! -x "$bin" ]]; then
    echo "building stt-session binary in $TARGET_DIR"
    set +e
    CARGO_TARGET_DIR=$TARGET_DIR cargo build -p stt-session --manifest-path "$REPO_ROOT/Cargo.toml" >"$art/cargo-build.stdout.txt" 2>"$art/cargo-build.stderr.txt"
    code=$?
    set -e
    echo "build_exit: $code" >>"$meta"
    if [[ "$code" -ne 0 ]]; then
      {
        echo "\$ cargo build -p stt-session"
        echo "--- stdout ---"
        cat "$art/cargo-build.stdout.txt"
        echo "--- stderr ---"
        cat "$art/cargo-build.stderr.txt"
        echo "--- exit $code ---"
      } >"$combined"
      echo "exit=$code"
      echo "transcript_path=$combined"
      return "$code"
    fi
    bin=$TARGET_DIR/debug/stt-session
    if [[ ! -x "$bin" && -x "$TARGET_DIR/debug/stt-session.exe" ]]; then
      bin=$TARGET_DIR/debug/stt-session.exe
    fi
  fi
  [[ -x "$bin" ]] || die "session binary missing at $TARGET_DIR/debug/stt-session"

  local failures=0
  session_probe() {
    local name=$1 want=$2 token=$3
    shift 3
    local pout=$art/probe-$name.stdout.txt perr=$art/probe-$name.stderr.txt
    set +e
    "$@" >"$pout" 2>"$perr"
    local got=$?
    set -e
    echo "probe=$name exit=$got want=$want" >>"$meta"
    if [[ "$got" != "$want" ]]; then
      echo "probe $name exited $got, want $want" >&2
      failures=$((failures + 1))
    fi
    if ! grep -q "$token" "$perr"; then
      echo "probe $name stderr is missing $token" >&2
      failures=$((failures + 1))
    fi
  }

  session_probe no-model 4 "STT_MODEL_DIR" env -u STT_MODEL_DIR "$bin"
  session_probe fn-chord 2 "Fn" env -u STT_MODEL_DIR STT_HOLD=Fn "$bin"
  session_probe bad-pack 4 "not a directory" env STT_MODEL_DIR="$art/no-such-pack" "$bin"

  {
    echo "model_dir=${STT_MODEL_DIR-<unset>}"
    echo "display=${DISPLAY-<unset>}"
    echo "note: a live session also needs a mic and a held chord; this command never starts one"
  } >"$art/live-preconditions.txt"

  {
    echo "\$ cargo test -p stt-session"
    echo "--- stdout ---"
    cat "$out"
    echo "--- stderr ---"
    cat "$err"
    echo "--- probes ---"
    grep "probe=" "$meta"
    echo "--- exit 0 ---"
  } >"$combined"

  if [[ "$failures" -ne 0 ]]; then
    echo "exit=1"
    echo "transcript_path=$combined"
    return 1
  fi

  echo "exit=0"
  echo "transcript_path=$combined"
  echo "artifacts=$art"
  return 0
}

cmd_cleanup() {
  local run_id
  if [[ -n "${STT_GPUI_VERIFY_RUN_ID:-}" ]]; then
    run_id=$STT_GPUI_VERIFY_RUN_ID
  elif [[ -f "$CURRENT_FILE" ]]; then
    run_id=$(cat "$CURRENT_FILE")
  else
    echo "nothing to clean"
    return 0
  fi

  local run_dir artifacts
  run_dir=$(run_dir_for "$run_id")
  artifacts=$ARTIFACTS_ROOT/$run_id

  if [[ -d "$run_dir" ]]; then
    rm -rf "$run_dir"
    echo "removed $run_dir"
  else
    echo "run directory already gone: $run_dir"
  fi

  if [[ -f "$CURRENT_FILE" ]] && [[ $(cat "$CURRENT_FILE") == "$run_id" ]]; then
    rm -f "$CURRENT_FILE"
  fi

  echo "evidence kept at $artifacts"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    cli)
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      cmd_cli "$@"
      ;;
    overlay) cmd_overlay "$@" ;;
    session) cmd_session "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    --help|-h|help|"") usage ;;
    *)
      usage >&2
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
