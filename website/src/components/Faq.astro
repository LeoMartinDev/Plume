---
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).faq;
---

<section id="faq" class="faq section">
  <h2 class="title">{s.title}</h2>
  {
    s.items.map((item) => (
      <details>
        <summary>
          {item.q}
          <span class="plus" aria-hidden="true">+</span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</section>

<style>
  .faq {
    max-width: 820px;
    margin: 0 auto;
    padding-inline: 24px;
  }
  .title {
    margin-bottom: 40px;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  details {
    border-top: 1px solid var(--border-strong);
    padding: 22px 0;
  }
  details:last-of-type {
    border-bottom: 1px solid var(--border-strong);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    font-size: 24px;
    font-weight: 300;
    transition: transform 0.2s ease;
    flex: none;
  }
  details[open] .plus {
    transform: rotate(45deg);
  }
  p {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
