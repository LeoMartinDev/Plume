---
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).features;
const demos = s.anyApp.demos;
const first = demos[0];
---

<section id="features" class="container section">
  <div class="intro">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="h2">{s.title1}<br /><span class="dim serif">{s.title2}</span></h2>
  </div>
  <div class="grid">
    <article class="wide" data-apps-demo data-demos={JSON.stringify(demos)}>
      <ul class="chips" aria-hidden="true">
        {s.anyApp.chips.map((c) => <li class:list={{ 'is-active': c === first.app }} data-app={c}>{c}</li>)}
        <li class="strong">{s.anyApp.chipLast}</li>
      </ul>
      <div class="field" aria-hidden="true">
        <p class="field-head">
          <span class="field-app" data-field-app>{first.app}</span>
          <span class="field-ctx mono" data-field-ctx>{first.context}</span>
        </p>
        <p class="field-text">
          {demos.map((d) => <span class="ghost">{d.text}</span>)}
          <span class="live" data-line><span data-typed>{first.text}</span><span class="caret"></span><span class="rest" data-rest></span></span>
        </p>
      </div>
      <div>
        <h3 class="wide-title">{s.anyApp.title}</h3>
        <p class="wide-text">{s.anyApp.text}</p>
      </div>
    </article>
    {
      s.items.map((item) => (
        <article class="card feature">
          {item.icon === '99' ? (
            <span class="big">99</span>
          ) : (
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {item.icon === 'local' && (
                <>
                  <rect x="3" y="4" width="18" height="12" rx="2" />
                  <path d="M8 20h8M12 16v4" />
                </>
              )}
              {item.icon === 'history' && (
                <>
                  <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                  <path d="M3 3v5h5M12 7v5l3 2" />
                </>
              )}
              {item.icon === 'theme' && (
                <>
                  <circle cx="12" cy="12" r="8" />
                  <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" />
                </>
              )}
              {item.icon === 'bolt' && <path d="M13 2 4 14h7l-1 8 9-12h-7z" />}
            </svg>
          )}
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .intro {
    max-width: 720px;
  }
  .dim {
    color: var(--title-dim);
  }
  .grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .wide {
    grid-column: span 2;
    min-width: 0;
    background: var(--feature-bg);
    color: var(--feature-fg);
    border-radius: var(--radius-lg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-height: 280px;
  }
  @media (min-width: 1000px) {
    .wide {
      grid-row: span 2;
    }
  }
  @media (max-width: 680px) {
    .wide {
      grid-column: auto;
      padding: 28px;
    }
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--feature-chip);
    color: var(--feature-muted);
    font-size: 14px;
    transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }
  .chips li.is-active {
    background: var(--feature-chip-active);
    color: var(--feature-fg);
    box-shadow: inset 0 0 0 1px var(--feature-ring);
  }
  .chips .strong {
    background: var(--feature-chip-strong-bg);
    color: var(--feature-chip-strong-fg);
  }
  /* A text field from the highlighted app, receiving the dictation */
  .field {
    padding: 18px 20px 16px;
    border-radius: 16px;
    background: var(--feature-field);
    border: 1px solid var(--feature-field-border);
  }
  .field-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
  }
  .field-app {
    font-weight: 600;
  }
  .field-ctx {
    min-width: 0;
    font-size: 12px;
    color: var(--feature-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Every demo line is laid out invisibly in the same cell, so the field is always
     as tall as the longest one and the card never resizes while cycling */
  .field-text {
    display: grid;
    margin-top: 10px;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .field-text > * {
    grid-area: 1 / 1;
  }
  .ghost {
    visibility: hidden;
  }
  .ghost::after {
    content: '';
    display: inline-block;
    width: 4px;
  }
  .live {
    transition: opacity 0.3s ease;
  }
  .live.is-clearing {
    opacity: 0;
  }
  .field .caret {
    background: var(--feature-caret);
  }
  .rest {
    color: transparent;
  }
  .wide-title {
    margin-bottom: 10px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .wide-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--feature-muted);
    max-width: 520px;
  }
  .feature {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .big {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 32px;
  }
  .feature h3 {
    margin-bottom: 8px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .feature p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>

<script>
  import { inViewport, motionAllowed, resetText, timeline, typeWords } from '../lib/demo';

  // Cycle through the apps: highlight one, dictate a line into its text field.
  const card = document.querySelector<HTMLElement>('[data-apps-demo]');
  const line = card?.querySelector<HTMLElement>('[data-line]');
  const typed = line?.querySelector<HTMLElement>('[data-typed]');
  const rest = line?.querySelector<HTMLElement>('[data-rest]');
  const app = card?.querySelector<HTMLElement>('[data-field-app]');
  const ctx = card?.querySelector<HTMLElement>('[data-field-ctx]');
  if (card && line && typed && rest && app && ctx && motionAllowed()) {
    const demos: { app: string; context: string; text: string }[] = JSON.parse(card.dataset.demos ?? '[]');
    const chips = card.querySelectorAll<HTMLElement>('[data-app]');
    const tl = timeline(card);

    // Same as the hero: below the fold, start from an empty field so the first app is typed
    // in view; already on screen, keep the rendered line for a moment first.
    const startEmpty = !inViewport(line);
    if (startEmpty) resetText(typed, rest, demos[0].text);

    (async () => {
      if (!startEmpty) await tl.wait(2400);
      for (let i = startEmpty ? 0 : 1; ; i = (i + 1) % demos.length) {
        const demo = demos[i];
        if (typed.textContent) {
          line.classList.add('is-clearing');
          await tl.wait(300);
        }
        resetText(typed, rest, demo.text);
        line.classList.remove('is-clearing');
        chips.forEach((c) => c.classList.toggle('is-active', c.dataset.app === demo.app));
        app.textContent = demo.app;
        ctx.textContent = demo.context;
        await tl.wait(700);
        await typeWords(typed, rest, demo.text, tl, 70);
        await tl.wait(2400);
      }
    })();
  }
</script>
