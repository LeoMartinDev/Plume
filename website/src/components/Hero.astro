---
import VoicePill from './VoicePill.astro';
import { t, KEYS, type Lang } from '../i18n/strings';
import { REPO_URL, type ReleaseInfo } from '../lib/release';

interface Props {
  lang: Lang;
  release: ReleaseInfo;
}
const { lang, release } = Astro.props;
const s = t(lang).hero;
const k = KEYS[lang];
const names = t(lang).download.platforms;
const states = ['idle', 'listening', 'transcribing', 'inserted'] as const;
---

<section id="top" class="container hero">
  <div class="glow" aria-hidden="true"></div>
  <p class="badge">
    {release.version && <span class="version">{release.version}</span>}
    {s.badge}
  </p>
  <h1 class="title">{s.title1}<br /><span class="dim serif">{s.title2}</span></h1>
  <p class="lead">{s.lead}</p>
  <div class="ctas">
    <a
      href="#download"
      class="btn btn-primary btn-lg"
      data-smart-download
      data-mac={release.assets.mac}
      data-windows={release.assets.windows}
      data-linux={release.assets.linux}
      data-label-prefix={s.downloadFor}
      data-name-mac={names.mac.name}
      data-name-windows={names.windows.name}
      data-name-linux={names.linux.name}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path></svg>
      <span data-label>{s.download}</span>
    </a>
    <a href={REPO_URL} class="btn btn-secondary btn-lg">{s.source}</a>
  </div>
  <p class="hint">
    {s.hold} <kbd data-hero-key>{k.ctrl}</kbd> <span aria-hidden="true">+</span> <kbd data-hero-key>{k.space}</kbd> {s.toTalk}
  </p>

  <div class="stage" data-hero-demo>
    <div class="window">
      <div class="chrome">
        <span></span><span></span><span></span>
        <em>{s.windowTitle}</em>
      </div>
      <div class="doc">
        <p class="doc-title">{s.docTitle}</p>
        <p>{s.docLine1}</p>
        <p class="dictated" data-line><mark data-typed>{s.docLine2}</mark><span class="caret" aria-hidden="true"></span><span class="rest" data-rest></span></p>
      </div>
      <div class="pill-slot" aria-hidden="true">
        {
          states.map((state) => (
            <span class:list={['pill-frame', { 'is-active': state === 'inserted' }]} data-pill={state}>
              <VoicePill state={state} lang={lang} />
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(64px, 9vw, 104px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .glow {
    position: absolute;
    top: 40px;
    left: 50%;
    width: min(760px, 90vw);
    height: 420px;
    transform: translateX(-50%);
    border-radius: 50%;
    filter: blur(90px);
    background: var(--accent);
    opacity: var(--glow-opacity);
    pointer-events: none;
  }
  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 8px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }
  .badge:not(:has(.version)) {
    padding-left: 14px;
  }
  .version {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .title {
    position: relative;
    margin-top: 28px;
    font-size: clamp(46px, 8vw, 104px);
    line-height: 0.95;
    font-weight: 600;
    letter-spacing: -0.055em;
    max-width: 980px;
  }
  .dim {
    color: var(--title-dim);
  }
  .title .serif {
    font-size: 1.1em;
    line-height: 0.9;
  }
  .lead {
    position: relative;
    margin-top: 28px;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.5;
    color: var(--muted);
    max-width: 580px;
  }
  .ctas {
    position: relative;
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .hint {
    position: relative;
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--subtle);
  }
  .hint kbd {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    color: var(--text);
    transition: transform 0.12s ease, background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .hint kbd.is-down {
    transform: translateY(1px);
    background: var(--highlight);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .stage {
    position: relative;
    margin-top: 64px;
    width: 100%;
    border-radius: 28px;
    background-color: var(--stage-bg);
    background-image: radial-gradient(var(--stage-dots) 1px, transparent 1px);
    background-size: 22px 22px;
    border: 1px solid var(--stage-border);
    padding: clamp(20px, 5vw, 64px) clamp(12px, 5vw, 64px) 0;
    overflow: hidden;
  }
  .window {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    background: var(--window-bg);
    border: 1px solid var(--window-border);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    text-align: left;
    overflow: hidden;
  }
  .chrome {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border-bottom: 1px solid var(--window-border);
  }
  .chrome span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--window-chrome);
  }
  .chrome em {
    margin-left: 12px;
    font-style: normal;
    font-size: 13px;
    color: var(--subtle);
  }
  .doc {
    padding: clamp(24px, 4vw, 44px) clamp(20px, 5vw, 56px) 124px;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--window-text);
    display: grid;
    gap: 12px;
  }
  .doc-title {
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--window-title);
    margin-bottom: 6px;
  }
  mark {
    border-radius: 4px;
    padding: 1px 2px;
    background: var(--highlight);
    color: var(--window-title);
    transition: background 0.8s ease;
  }
  mark:empty {
    padding: 0;
  }
  .dictated {
    transition: opacity 0.35s ease;
  }
  .dictated.is-settled mark {
    background: transparent;
  }
  .dictated.is-clearing {
    opacity: 0;
  }
  .rest {
    color: transparent;
  }
  .pill-slot {
    position: absolute;
    left: 50%;
    bottom: 40px;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
  }
  /* The four pill states share one slot and cross-fade */
  .pill-frame {
    grid-area: 1 / 1;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .pill-frame:not(.is-active) {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  .btn-lg {
    height: 52px;
  }
  @media (max-width: 520px) {
    .ctas {
      width: 100%;
    }
    .ctas .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { inViewport, motionAllowed, resetText, timeline, typeWords } from '../lib/demo';

  // Loop the dictation: hold the keys, speak, release, the text lands in the note.
  const stage = document.querySelector<HTMLElement>('[data-hero-demo]');
  const line = stage?.querySelector<HTMLElement>('[data-line]');
  const typed = line?.querySelector<HTMLElement>('[data-typed]');
  const rest = line?.querySelector<HTMLElement>('[data-rest]');
  if (stage && line && typed && rest && motionAllowed()) {
    const text = typed.textContent ?? '';
    const keys = document.querySelectorAll<HTMLElement>('[data-hero-key]');
    const frames = stage.querySelectorAll<HTMLElement>('[data-pill]');
    const setPill = (state: string) => frames.forEach((f) => f.classList.toggle('is-active', f.dataset.pill === state));
    const press = (down: boolean) => keys.forEach((k) => k.classList.toggle('is-down', down));
    const tl = timeline(stage);

    // The server renders the finished frame (no-JS and reduced-motion fallback). When the
    // demo is still below the fold, swap it for an empty note so people scrolling to it
    // watch the dictation from the start. If it is already on screen, wind down from the
    // rendered frame instead of jumping.
    const startEmpty = !inViewport(line);
    if (startEmpty) {
      resetText(typed, rest, text);
      setPill('idle');
    }

    (async () => {
      for (let first = true; ; first = false) {
        if (!first || !startEmpty) {
          await tl.wait(1800);
          line.classList.add('is-settled');
          await tl.wait(1400);
          setPill('idle');
          await tl.wait(1400);
          line.classList.add('is-clearing');
          await tl.wait(350);
          resetText(typed, rest, text);
          line.classList.remove('is-clearing', 'is-settled');
        }
        await tl.wait(first ? 700 : 500);
        press(true);
        setPill('listening');
        await tl.wait(2600);
        press(false);
        setPill('transcribing');
        await tl.wait(1100);
        setPill('inserted');
        await typeWords(typed, rest, text, tl, 45);
      }
    })();
  }
</script>
