---
import { t, KEYS, type Lang } from '../i18n/strings';

interface Props {
  state: 'idle' | 'listening' | 'transcribing' | 'inserted';
  lang: Lang;
  class?: string;
}

const { state, lang, class: className } = Astro.props;
const s = t(lang).pill;
const k = KEYS[lang];
const bars = [6, 16, 20, 12, 18, 8, 20, 14, 7, 17, 11, 6];
---

<div class:list={['pill', `pill--${state}`, className]}>
  {
    state === 'idle' && (
      <>
        <span class="dot dot--idle" aria-hidden="true" />
        <span class="label">{s.ready}</span>
        <span class="keys">
          <kbd>{k.ctrl}</kbd>
          <kbd>{k.space}</kbd>
        </span>
      </>
    )
  }
  {
    state === 'listening' && (
      <>
        <span class="dot dot--live" aria-hidden="true" />
        <span class="wave" aria-hidden="true">
          {bars.map((h, i) => (
            <span style={`--h:${h}px;--d:${0.8 + (i % 5) * 0.1}s;--o:${-(i % 4) * 0.25}s`} />
          ))}
        </span>
        <span class="label">{s.listening}</span>
        <kbd>{k.esc}</kbd>
      </>
    )
  }
  {
    state === 'transcribing' && (
      <>
        <span class="dots" aria-hidden="true">
          <span />
          <span />
          <span />
        </span>
        <span class="label label--end">{s.transcribing}</span>
      </>
    )
  }
  {
    state === 'inserted' && (
      <>
        <span class="check" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <span class="label label--end">{s.inserted}</span>
      </>
    )
  }
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 46px;
    padding: 0 8px 0 15px;
    border-radius: 999px;
    white-space: nowrap;
    font-size: 13px;
    background: var(--pill-bg);
    color: var(--pill-fg);
    box-shadow: var(--pill-shadow);
  }
  .label {
    color: var(--pill-muted);
  }
  .label--end {
    padding-right: 8px;
  }
  kbd {
    font-size: 11px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--pill-chip);
    color: var(--pill-chip-fg);
  }
  .keys {
    display: flex;
    gap: 4px;
  }
  .dot {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }
  .dot--idle {
    background: var(--pill-idle);
  }
  .dot--live {
    background: var(--accent);
  }
  .dot--live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 1.6s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.5;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 22px;
  }
  .wave span {
    width: 3px;
    height: var(--h);
    border-radius: 3px;
    background: var(--pill-fg);
    animation: wave var(--d) ease-in-out var(--o) infinite;
  }
  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.4);
    }
    50% {
      transform: scaleY(1.1);
    }
  }
  .dots {
    display: flex;
    gap: 4px;
  }
  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: fade 1s ease-in-out infinite;
  }
  .dots span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .dots span:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes fade {
    50% {
      opacity: 0.25;
    }
  }
  .check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    flex: none;
  }
</style>
